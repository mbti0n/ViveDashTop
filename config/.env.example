# Copy to config/.env. The dashboard reads this file itself.
# Sign-in uses these three Auth0 values. Gemini and Last.fm stay optional.

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

GEMINI_API_KEY=
# Optional. info.py defaults to gemini-3.8-flash when this is unset.
GEMINI_MODEL=gemini-3.8-flash

LASTFM_API_KEY=
LASTFM_USERNAME=

# Optional comma-separated names for the briefing's sports context.
# Example: MAGIC,BUCCANEERS
SPORTS_FAVORITES=
